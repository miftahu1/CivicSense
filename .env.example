NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
# Optional stable HMAC secret for abuse IP/content fingerprints; falls back to the service role key.
# ABUSE_IP_HASH_SECRET=generate-a-long-random-server-only-secret
# Optional only when your host uses a different trusted, proxy-injected client IP header.
# CIVICSENSE_CLIENT_IP_HEADER=x-vercel-forwarded-for
GEMINI_API_KEY=YOUR_SERVER_ONLY_GEMINI_API_KEY
BACKUP_GEMINI_API_KEY=YOUR_SECOND_GOOGLE_ACCOUNT_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
SIMILARITY_THRESHOLD=0.82
EMAILJS_SERVICE_ID=YOUR_EMAILJS_SERVICE_ID
EMAILJS_PUBLIC_KEY=YOUR_EMAILJS_PUBLIC_KEY
EMAILJS_PRIVATE_KEY=YOUR_EMAILJS_PRIVATE_KEY
EMAILJS_DEPARTMENT_ALERT_TEMPLATE_ID=YOUR_EMAILJS_TEMPLATE_ID
NEXT_PUBLIC_APP_URL=http://localhost:3000
